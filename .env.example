# ─── Jab We Wed — environment template ─────────────────────────────────────
# Copy to .env.local for local dev. In Vercel, set these per environment.
# NEVER reuse the original Face Match project's Supabase or AWS credentials.

# Public site URL (used in QR codes). e.g. https://jab-we-wed-face-scan.vercel.app
NEXT_PUBLIC_SITE_URL=

# NEW, independent Supabase project for Jab We Wed
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin login. Use a long random code (20+ chars).
ADMIN_ACCESS_CODE=
# Server-only HMAC secret for admin session cookies (32+ random chars).
ADMIN_SESSION_SECRET=

# Amazon Rekognition — use a dedicated IAM user for this app
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Collection namespace. Each wedding gets "<prefix>-<event uuid>".
# Keep this different from the original app's prefix ("smf-face").
AWS_REKOGNITION_COLLECTION_PREFIX=jab-we-wed

# Google Drive folder import (read-only API key; Google Cloud → APIs & Services →
# Credentials → Create API key, restricted to "Google Drive API").
# Wedding folders must be shared as "Anyone with the link can view".
GOOGLE_DRIVE_API_KEY=

# Optional tuning
# Minimum Rekognition similarity (0-100) for a photo to count as a match.
MATCH_SIMILARITY_THRESHOLD=80
# How long a guest's verified download session lasts (minutes).
DOWNLOAD_SESSION_MINUTES=120
# Selfie scans allowed per IP per 10 minutes.
MATCH_RATE_LIMIT=12
# Optional: total storage quota shown in the admin dashboard (GB).
SUPABASE_STORAGE_LIMIT_GB=
